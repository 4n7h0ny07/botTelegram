# Token del bot creado en BotFather.
TELEGRAM_TOKEN=tu_token_aqui

PORT=3000
DB_FILE=./botdata.sqlite

# API REST de Binance P2P.
BINANCE_API_URL=https://p2p.binance.com/bapi/c2c/v2/friendly/c2c/adv/search

# Cantidad de anuncios usados para calcular la media.
AVG_ROWS=5

# Solo se usa como sugerencia al crear alertas de brecha.
GAP_DEFAULT_LIMIT=15

# Intervalo de revision de alertas.
CHECK_INTERVAL_MS=30000
